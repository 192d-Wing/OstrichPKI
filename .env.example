# OstrichPKI Environment Configuration Template
#
# COMPLIANCE MAPPING:
# - NIST 800-53: CM-6 (Configuration Settings)
# - NIST 800-53: SC-28 (Protection of Information at Rest)
#
# Copy this file to .env and configure for your environment.
# NEVER commit .env files containing secrets to version control.

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=ostrich
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_DB=ostrich_pki

# =============================================================================
# Logging Configuration
# =============================================================================
# Log level: trace, debug, info, warn, error
RUST_LOG=info
# Use JSON format for structured logging in production
LOG_JSON=true

# =============================================================================
# CA Service Configuration
# =============================================================================
# CA certificate and key files (PEM format)
# Required for full CA functionality
CA_CERT_FILE=/app/certs/ca.pem
CA_KEY_FILE=/app/certs/ca-key.pem

# =============================================================================
# CA gRPC mTLS (acme/est -> CA issuance API)
# =============================================================================
# COMPLIANCE MAPPING:
# - NIST 800-53: SC-8, AC-17 (TLS 1.3 mutual TLS, aws-lc-rs FIPS provider)
# - NIST 800-53: IA-3, AC-3 (client certificate + subject allowlist), CM-6
# - NIAP PP-CA: FTP_ITC.1, FCS_TLSS_EXT.2, FCS_TLSC_EXT.2
#
# The CA gRPC API ONLY serves mutually authenticated TLS 1.3 and refuses to
# start if any of these are missing. `make dev-grpc-certs` writes DEV ONLY
# material to ./.dev-grpc-certs; production uses CA-issued certificates (see
# docs/runbooks/ca-grpc-mtls.md). Values are FILE PATHS inside the container,
# never key material.
#
# Per-service host directories, bind-mounted read-only (docker-compose.yml).
# Each container gets ONLY its own key (AC-6, SC-12). Defaults are the DEV ONLY
# subdirectories written by `make dev-grpc-certs`. Always use directories
# OUTSIDE ./certs (ca, est and ocsp mount ./certs wholesale).
#   ca-server -> /app/grpc-tls:        tls.crt, tls.key, client-ca.crt
#   acme/est  -> /app/ca-grpc-client:  tls.crt, tls.key, ca.crt
CA_GRPC_TLS_DIR=./.dev-grpc-certs/ca-server
ACME_CA_GRPC_CLIENT_DIR=./.dev-grpc-certs/acme-server
EST_CA_GRPC_CLIENT_DIR=./.dev-grpc-certs/est-server
# ca-server: server certificate chain (SAN must include the host clients dial,
# e.g. DNS:ca), private key, and the trust anchor for client certificates.
# client-ca.crt MUST be a dedicated service-identity CA that issues nothing
# but gRPC service certificates; ca-server refuses to start if it contains the
# CA's own subscriber-issuing certificate. Client certs must carry an EKU
# extension that includes clientAuth.
CA_GRPC_TLS_CERT_FILE=/app/grpc-tls/tls.crt
CA_GRPC_TLS_KEY_FILE=/app/grpc-tls/tls.key
CA_GRPC_TLS_CLIENT_CA_FILE=/app/grpc-tls/client-ca.crt
# ca-server: ";"-delimited RFC 4514 subject DNs allowed to call the gRPC API
# (commas separate RDNs inside one DN; values match exactly, case-sensitive;
# no ";" inside a DN, even escaped). Empty = refuse to start. Any other
# client gets PERMISSION_DENIED and an audit event.
CA_GRPC_ALLOWED_CLIENT_SUBJECTS=CN=acme-server;CN=est-server
#
# acme-server / est-server client identities. Each container receives these as
# CA_GRPC_URL, CA_GRPC_CLIENT_CERT_FILE, CA_GRPC_CLIENT_KEY_FILE and
# CA_GRPC_CA_CERT_FILE (all three files or none). The client verifies the CA
# server name against the URL host unless CA_GRPC_SERVER_NAME is set in the
# service environment.
ACME_CA_GRPC_URL=https://ca:50051
ACME_CA_GRPC_CLIENT_CERT_FILE=/app/ca-grpc-client/tls.crt
ACME_CA_GRPC_CLIENT_KEY_FILE=/app/ca-grpc-client/tls.key
ACME_CA_GRPC_CA_CERT_FILE=/app/ca-grpc-client/ca.crt
EST_CA_GRPC_URL=https://ca:50051
EST_CA_GRPC_CLIENT_CERT_FILE=/app/ca-grpc-client/tls.crt
EST_CA_GRPC_CLIENT_KEY_FILE=/app/ca-grpc-client/tls.key
EST_CA_GRPC_CA_CERT_FILE=/app/ca-grpc-client/ca.crt
#
# Debug builds / dev only (`cargo run`). Leave false. Release builds (all
# container images) refuse both at startup: ca-server exits on
# CA_GRPC_INSECURE_DEV_PLAINTEXT=true, and acme-server / est-server exit on
# CA_GRPC_INSECURE=true (plaintext client channel). NIST 800-53: CM-6, SC-8.
# These are not wired into any compose file.
# CA_GRPC_INSECURE_DEV_PLAINTEXT=false
# CA_GRPC_INSECURE=false

# =============================================================================
# ACME Service Configuration
# =============================================================================
# External base URL for ACME directory (used for URLs in responses)
ACME_BASE_URL=https://acme.example.com

# =============================================================================
# EST Service Configuration
# =============================================================================
# TLS configuration for EST (requires mTLS per RFC 7030)
EST_TLS_CERT_FILE=/app/certs/est-service.pem
EST_TLS_KEY_FILE=/app/certs/est-service-key.pem
EST_TLS_CA_CERT_FILE=/app/certs/root-ca.pem

# =============================================================================
# OCSP Service Configuration
# =============================================================================
# OCSP signing certificate and key
OCSP_SIGNING_CERT=/app/certs/ocsp-signer.pem
OCSP_SIGNING_KEY=/app/certs/ocsp-signer-key.pem

# =============================================================================
# HSM Configuration (optional)
# =============================================================================
# PKCS#11 library path for HSM integration
# HSM_PKCS11_LIBRARY=/usr/lib/softhsm/libsofthsm2.so
# HSM_SLOT=0
# HSM_PIN=CHANGE_ME_HSM_PIN
